{
  "name": "nexo-lambda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch api/src/local-api.ts",
    "start": "node dist/src/local-api.js",
    "check:ui": "tsc -p frontend/tsconfig.json",
    "build:ui": "npm run check:ui && vite build --config frontend/vite.config.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "demo": "node scripts/demo.mjs",
    "demo:stop": "node scripts/demo.mjs --stop",
    "test": "node scripts/test-local.mjs",
    "test:lambda": "node --import tsx --test api/test/storefront.test.ts api/test/auth.test.ts",
    "preinvoke:lambda": "npm run build --silent",
    "invoke:lambda": "node scripts/invoke-lambda.mjs",
    "package:lambda": "npm run build && node scripts/generate-template.mjs && node scripts/package-lambda.mjs",
    "deploy:lambda": "npm run package:lambda && npm run build:ui && node scripts/deploy-lambda.mjs",
    "lint": "eslint api frontend --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run build && npm run check:ui",
    "test:dynamo": "DYNAMO_ENDPOINT=${DYNAMO_ENDPOINT:-http://127.0.0.1:8000} node --import tsx --test api/test/dynamo.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@faker-js/faker": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5",
    "lucide-react": "^1.55.0",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "node-pg-migrate": "^9.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4"
  }
}
